<?xml version="1.0" encoding="UTF-8"?>
<jxb:bindings version="2.1"
    xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- leiauteConfRecebto_v1.00.xsd (manifestacao destinatario) -->
  <jxb:bindings schemaLocation="../../schemas/leiauteConfRecebto_v1.00.xsd">
    <jxb:bindings node="//xs:complexType[@name='TEvento']">
      <jxb:class name="TEventoManifestacao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TretEvento']">
      <jxb:class name="TRetEventoManifestacao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TEnvEvento']">
      <jxb:class name="TEnvEventoManifestacao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TRetEnvEvento']">
      <jxb:class name="TRetEnvEventoManifestacao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TProcEvento']">
      <jxb:class name="TProcEventoManifestacao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- confRecebto_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/confRecebto_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='evento']">
      <jxb:factoryMethod name="EventoManifestacao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- envConfRecebto_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/envConfRecebto_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='envEvento']">
      <jxb:factoryMethod name="EnvEventoManifestacao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- retEnvConfRecebto_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/retEnvConfRecebto_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='retEnvEvento']">
      <jxb:factoryMethod name="RetEnvEventoManifestacao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- procConfRecebtoNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/procConfRecebtoNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='procEventoNFe']">
      <jxb:factoryMethod name="ProcEventoManifestacao"/>
    </jxb:bindings>
  </jxb:bindings>

</jxb:bindings>
