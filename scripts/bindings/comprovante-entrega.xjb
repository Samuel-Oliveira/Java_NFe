<?xml version="1.0" encoding="UTF-8"?>
<jxb:bindings version="2.1"
    xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- leiauteEventoEntregaNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/leiauteEventoEntregaNFe_v1.00.xsd">
    <jxb:bindings node="//xs:complexType[@name='TEvento']">
      <jxb:class name="TEventoComprovanteEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TretEvento']">
      <jxb:class name="TRetEventoComprovanteEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TEnvEvento']">
      <jxb:class name="TEnvEventoComprovanteEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TRetEnvEvento']">
      <jxb:class name="TRetEnvEventoComprovanteEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TProcEvento']">
      <jxb:class name="TProcEventoComprovanteEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- EventoEntregaNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/EventoEntregaNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='evento']">
      <jxb:factoryMethod name="EventoComprovanteEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- envEventoEntregaNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/envEventoEntregaNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='envEvento']">
      <jxb:factoryMethod name="EnvEventoComprovanteEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- procEventoEntregaNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/procEventoEntregaNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='procEventoNFe']">
      <jxb:factoryMethod name="ProcEventoComprovanteEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- retEventoEntregaNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/retEventoEntregaNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='retEnvEvento']">
      <jxb:factoryMethod name="RetEnvEventoComprovanteEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

</jxb:bindings>
