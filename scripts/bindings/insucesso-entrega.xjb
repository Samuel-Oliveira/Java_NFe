<?xml version="1.0" encoding="UTF-8"?>
<jxb:bindings version="2.1"
    xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- leiauteEventoInsucessoNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/leiauteEventoInsucessoNFe_v1.00.xsd">
    <jxb:bindings node="//xs:complexType[@name='TEvento']">
      <jxb:class name="TEventoInsucessoEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TretEvento']">
      <jxb:class name="TRetEventoInsucessoEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TEnvEvento']">
      <jxb:class name="TEnvEventoInsucessoEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TRetEnvEvento']">
      <jxb:class name="TRetEnvEventoInsucessoEntrega"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TProcEvento']">
      <jxb:class name="TProcEventoInsucessoEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- EventoInsucessoNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/EventoInsucessoNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='evento']">
      <jxb:factoryMethod name="EventoInsucessoEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- envEventoInsucessoNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/envEventoInsucessoNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='envEvento']">
      <jxb:factoryMethod name="EnvEventoInsucessoEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- procEventoInsucessoNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/procEventoInsucessoNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='procEventoNFe']">
      <jxb:factoryMethod name="ProcEventoInsucessoEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- retEventoInsucessoNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/retEventoInsucessoNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='retEnvEvento']">
      <jxb:factoryMethod name="RetEnvEventoInsucessoEntrega"/>
    </jxb:bindings>
  </jxb:bindings>

</jxb:bindings>
