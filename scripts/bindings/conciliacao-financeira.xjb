<?xml version="1.0" encoding="UTF-8"?>
<jxb:bindings version="2.1"
    xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- leiauteEventoEConf_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/leiauteEventoEConf_v1.00.xsd">
    <jxb:bindings node="//xs:complexType[@name='TEvento']">
      <jxb:class name="TEventoConciliacaoFinanceira"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TretEvento']">
      <jxb:class name="TRetEventoConciliacaoFinanceira"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TEnvEvento']">
      <jxb:class name="TEnvEventoConciliacaoFinanceira"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TRetEnvEvento']">
      <jxb:class name="TRetEnvEventoConciliacaoFinanceira"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TProcEvento']">
      <jxb:class name="TProcEventoConciliacaoFinanceira"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- EventoEConf_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/EventoEConf_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='evento']">
      <jxb:factoryMethod name="EventoConciliacaoFinanceira"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- envEventoEConf_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/envEventoEConf_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='envEvento']">
      <jxb:factoryMethod name="EnvEventoConciliacaoFinanceira"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- procEventoEConf_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/procEventoEConf_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='procEventoNFe']">
      <jxb:factoryMethod name="ProcEventoConciliacaoFinanceira"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- retEventoEConf_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/retEventoEConf_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='retEnvEvento']">
      <jxb:factoryMethod name="RetEnvEventoConciliacaoFinanceira"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- patch-bindings-detevento: DetEventoConciliacaoFinanceira -->
  <jxb:bindings schemaLocation="../../schemas/e110750_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='detEvento']/xs:complexType">
      <jxb:class name="DetEventoConciliacaoFinanceira"/>
    </jxb:bindings>
  </jxb:bindings>

</jxb:bindings>
