<?xml version="1.0" encoding="UTF-8"?>
<jxb:bindings version="2.1"
    xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- leiauteCCe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/leiauteCCe_v1.00.xsd">
    <jxb:bindings node="//xs:complexType[@name='TEvento']">
      <jxb:class name="TEventoCartaCorrecao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TretEvento']">
      <jxb:class name="TRetEventoCartaCorrecao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TEnvEvento']">
      <jxb:class name="TEnvEventoCartaCorrecao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TRetEnvEvento']">
      <jxb:class name="TRetEnvEventoCartaCorrecao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TProcEvento']">
      <jxb:class name="TProcEventoCartaCorrecao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- CCe_v1.00.xsd (element evento) -->
  <jxb:bindings schemaLocation="../../schemas/CCe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='evento']">
      <jxb:factoryMethod name="EventoCartaCorrecao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- envCCe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/envCCe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='envEvento']">
      <jxb:factoryMethod name="EnvEventoCartaCorrecao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- retEnvCCe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/retEnvCCe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='retEnvEvento']">
      <jxb:factoryMethod name="RetEnvEventoCartaCorrecao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- procCCeNFe_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/procCCeNFe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='procEventoNFe']">
      <jxb:factoryMethod name="ProcEventoCartaCorrecao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- patch-bindings-detevento: DetEventoCartaCorrecao -->
  <jxb:bindings schemaLocation="../../schemas/leiauteCCe_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='detEvento']/xs:complexType">
      <jxb:class name="DetEventoCartaCorrecao"/>
    </jxb:bindings>
  </jxb:bindings>

</jxb:bindings>
