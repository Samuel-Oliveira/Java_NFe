<?xml version="1.0" encoding="UTF-8"?>
<jxb:bindings version="2.1"
    xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- leiauteEventoCancSubst_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/leiauteEventoCancSubst_v1.00.xsd">
    <jxb:bindings node="//xs:complexType[@name='TEvento']">
      <jxb:class name="TEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TRetEvento']">
      <jxb:class name="TRetEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TEnvEvento']">
      <jxb:class name="TEnvEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TRetEnvEvento']">
      <jxb:class name="TRetEnvEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:complexType[@name='TProcEvento']">
      <jxb:class name="TProcEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- eventoCancSubst_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/eventoCancSubst_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='evento']">
      <jxb:factoryMethod name="EventoCancelamentoSubstituicao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- envEventoCancSubst_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/envEventoCancSubst_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='envEvento']">
      <jxb:factoryMethod name="EnvEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- retEnvEventoCancSubst_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/retEnvEventoCancSubst_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='retEnvEvento']">
      <jxb:factoryMethod name="RetEnvEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- procEventoCancSubst_v1.00.xsd -->
  <jxb:bindings schemaLocation="../../schemas/procEventoCancSubst_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='procEventoNFe']">
      <jxb:factoryMethod name="ProcEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
  </jxb:bindings>

  <!-- patch-bindings-detevento: DetEventoCancelamentoSubstituicao -->
  <jxb:bindings schemaLocation="../../schemas/leiauteEventoCancSubst_v1.00.xsd">
    <jxb:bindings node="//xs:element[@name='detEvento']/xs:complexType">
      <jxb:class name="DetEventoCancelamentoSubstituicao"/>
    </jxb:bindings>
  </jxb:bindings>

</jxb:bindings>
